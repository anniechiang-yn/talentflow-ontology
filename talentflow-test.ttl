@prefix : <https://anniechiang-data.framer.website/ontology/talentflow-test#> .
@prefix tf: <https://anniechiang-data.framer.website/ontology/talentflow#> .
@prefix ds: <https://anniechiang-data.framer.website/vocab/decision-status#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://anniechiang-data.framer.website/ontology/talentflow-test> rdf:type owl:Ontology ;
    owl:imports <https://anniechiang-data.framer.website/ontology/talentflow/1.1.0> ;
    rdfs:comment "Test individuals for TalentFlow. Expected inferences: testEvent1 is a Decided event; testDecision1 is a Superseded decision; testDecision2 is not."@en ,
                 "TalentFlow 測試個體。預期推理結果：testEvent1 歸入「已決策事件」；testDecision1 歸入「已被取代的決策」；testDecision2 不歸入。"@zh-hant .

:testEvent1 rdf:type owl:NamedIndividual , tf:ComplianceEvent ;
    tf:hasDecision :testDecision1 , :testDecision2 .

:testDecision1 rdf:type owl:NamedIndividual , tf:Decision ;
    tf:hasDecisionStatus ds:Implemented .

:testDecision2 rdf:type owl:NamedIndividual , tf:Decision ;
    tf:hasDecisionStatus ds:Decided ;
    tf:supersedes :testDecision1 .
