# CQ 14：涉及某法規條款的事件有哪些？（以 GDPR Art. 33 為例）
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX tf:   <https://anniechiang-data.framer.website/ontology/talentflow#>
PREFIX tfs:  <https://anniechiang-data.framer.website/ontology/talentflow-sample#>

SELECT ?event ?label WHERE {
  ?event tf:involvesRegulation tfs:gdprArt33 ;
         rdfs:label ?label .
  FILTER(LANGMATCHES(LANG(?label), "en"))
} ORDER BY ?label
