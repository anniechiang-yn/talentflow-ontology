# CQ 6：沒有指派負責人的事件有哪些？
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX tf:   <https://anniechiang-data.framer.website/ontology/talentflow#>

SELECT ?event ?label WHERE {
  ?event a tf:ComplianceEvent ;
         rdfs:label ?label .
  FILTER NOT EXISTS { ?event tf:hasResponsibleActor ?actor }
  FILTER(LANGMATCHES(LANG(?label), "en"))
}
