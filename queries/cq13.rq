# CQ 13: Which documents are linked to event X? (example: E2)
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX tf:   <https://anniechiang-data.framer.website/ontology/talentflow#>
PREFIX tfs:  <https://anniechiang-data.framer.website/ontology/talentflow-sample#>

SELECT ?document ?label WHERE {
  tfs:e2 tf:hasDocument ?document .
  ?document rdfs:label ?label .
  FILTER(LANGMATCHES(LANG(?label), "en"))
}
