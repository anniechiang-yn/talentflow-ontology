# CQ 15: Which events have a status under a given broader concept? (example: Decision-bearing)
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX tf:   <https://anniechiang-data.framer.website/ontology/talentflow#>
PREFIX ds:   <https://anniechiang-data.framer.website/vocab/decision-status#>

SELECT DISTINCT ?event ?label WHERE {
  ?event tf:hasDecision/tf:hasDecisionStatus/skos:broader* ds:DecisionBearing ;
         rdfs:label ?label .
  FILTER(LANGMATCHES(LANG(?label), "en"))
} ORDER BY ?label
