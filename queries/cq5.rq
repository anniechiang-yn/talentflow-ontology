# CQ 5: Which open events is a given actor responsible for? (example: the Data Protection Officer, dpo)
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX tf:   <https://anniechiang-data.framer.website/ontology/talentflow#>
PREFIX tfs:  <https://anniechiang-data.framer.website/ontology/talentflow-sample#>

SELECT ?event ?label ?deadline WHERE {
  ?event tf:hasResponsibleActor tfs:dpo ;
         rdfs:label ?label ;
         tf:hasDeadline ?deadline .
  FILTER NOT EXISTS { ?event tf:hasClosedDate ?closed }
  FILTER(LANGMATCHES(LANG(?label), "en"))
} ORDER BY ?deadline
